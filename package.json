{
  "name": "backend-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test": "bun test",
    "migration:up": "bun src/infrastructure/database/run-migrations.ts up",
    "migration:down": "bun src/infrastructure/database/run-migrations.ts down",
    "worker:sqs": "bun src/worker/sqs-wager-consumer.ts",
    "worker:outbox": "bun src/worker/outbox-publisher.ts",
    "worker:pending-references": "bun src/worker/pending-reference-reprocessor.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.670.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.12",
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/infrastructure/database/mikro-orm.config.ts"
    ]
  }
}
